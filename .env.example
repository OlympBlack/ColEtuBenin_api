APP_NAME="KAVI ColUAC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coluac
DB_USERNAME=coluac_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, les e-mails (OTP) sont journalisés dans storage/logs/laravel.log
MAIL_MAILER=log
MAIL_HOST=mail.lavoixdabouloussi.org
MAIL_PORT=465
MAIL_USERNAME=contact@colcampusapi.lavoixdabouloussi.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@colcampusapi.lavoixdabouloussi.org"
MAIL_FROM_NAME="ColCampus"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Temps réel (Laravel Reverb) - laisser BROADCAST_CONNECTION=log si aucun serveur Reverb n'est lancé
# BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Notifications Web Push (VAPID)
# Generer les cles avec: php -r "require 'vendor/autoload.php'; print_r(\Minishlink\WebPush\VAPID::createVapidKeys());"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:contact@colcampus.bj"
WEBPUSH_TTL=2419200
WEBPUSH_URGENCY=high

# Paiement mobile money (Kkiapay) - mode sandbox
KKIAPAY_PUBLIC_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SANDBOX=true

VITE_KKIAPAY_PUBLIC_KEY="${KKIAPAY_PUBLIC_KEY}"
